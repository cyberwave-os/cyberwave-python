{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.cyberwave.com/simulation.compatibility_attestation.v1.schema.json", "title": "Cyberwave Simulation Compatibility Attestation", "description": "Evidence that an asset revision (or assembled environment) passed the compatibility suite for one backend, feature profile and execution profile under exact bundle/exporter/runtime/extension/physics fingerprints. Any change to a key field invalidates it. key_digest is 'sha256:' + hex sha256 of the canonical JSON of key (see cyberwave_contracts.simulation.attestation_key_digest). Evidence locations are opaque references, never signed URLs.", "type": "object", "additionalProperties": true, "required": ["contract", "attestation_id", "key", "key_digest", "tests", "tolerances", "evidence", "status", "issued_at", "expires_at", "reason"], "properties": {"contract": {"const": "simulation.compatibility_attestation.v1"}, "attestation_id": {"type": "string"}, "key": {"type": "object", "additionalProperties": true, "required": ["asset_uuid", "asset_revision", "environment_uuid", "environment_revision", "backend", "feature_profile_id", "execution_profile", "bundle_digest", "exporter_version", "runtime_version", "image_digest", "extension_lock_digest", "physics_engine", "physics_variant", "test_suite_revision", "controller_revision", "config_revision", "resource_envelope"], "properties": {"asset_uuid": {"type": ["string", "null"]}, "asset_revision": {"type": ["string", "null"]}, "environment_uuid": {"type": ["string", "null"]}, "environment_revision": {"type": ["string", "null"]}, "backend": {"enum": ["mujoco", "mujoco_warp", "isaac"]}, "feature_profile_id": {"type": "string"}, "execution_profile": {"enum": ["isaac-cpu-physics", "isaac-gpu-physics", "isaac-newton-physics", null]}, "bundle_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "exporter_version": {"type": ["string", "null"]}, "runtime_version": {"type": ["string", "null"]}, "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "extension_lock_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "physics_engine": {"type": ["string", "null"], "description": "Engine the suite ran, e.g. physx or newton; must be the one execution_profile selects. Attestations are per execution profile, so a Newton pass never implies a PhysX pass and vice versa."}, "physics_variant": {"type": ["string", "null"]}, "test_suite_revision": {"type": "string"}, "controller_revision": {"type": ["string", "null"]}, "config_revision": {"type": ["string", "null"]}, "resource_envelope": {"type": ["object", "null"], "description": "Machine/GPU/driver class the evidence was produced on."}}}, "key_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "tests": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["test_id", "status"], "properties": {"test_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "skipped"]}, "evidence_ref": {"type": ["string", "null"]}, "detail": {"type": ["string", "null"]}}}}, "tolerances": {"type": "object", "description": "Tolerances the tests were evaluated against (same shape as replay trace tolerances)."}, "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["kind", "location"], "properties": {"kind": {"type": "string", "description": "e.g. replay_trace, diff_report, log, video"}, "location": {"type": "string", "description": "Opaque reference (artifact id or bucket-relative path). Never a signed URL."}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}}, "status": {"enum": ["pending", "passed", "failed", "expired", "invalidated"]}, "issued_at": {"type": "string", "description": "RFC 3339 UTC timestamp."}, "expires_at": {"type": ["string", "null"], "description": "RFC 3339 UTC timestamp, or null for no time-based expiry."}, "invalidated_at": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"], "description": "Why the status is what it is (failure, invalidation trigger)."}}}