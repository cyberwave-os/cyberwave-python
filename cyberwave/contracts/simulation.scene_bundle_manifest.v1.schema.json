{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.cyberwave.com/simulation.scene_bundle_manifest.v1.schema.json", "title": "Cyberwave Simulation Scene Bundle Manifest", "description": "Manifest of an immutable, self-contained OpenUSD scene bundle exported from Cyberwave Format. Every path is relative to the bundle root and confined to it (no leading '/', no '..' segment, no scheme). bundle_digest is 'sha256:' + hex sha256 over the canonical file list (see cyberwave_contracts.simulation.compute_bundle_digest); the manifest file itself is not listed in files. A referenced dependency missing from files is fatal. The manifest never carries URLs, signed URLs, credentials or authorization claims.", "type": "object", "additionalProperties": true, "required": ["contract", "schema_version", "bundle_digest", "created_at", "source", "root_layer", "files", "exporter", "runtime", "physics", "units", "identity_map", "articulations", "sensors", "compatibility", "resource_estimate", "provenance"], "properties": {"contract": {"const": "simulation.scene_bundle_manifest.v1"}, "schema_version": {"type": "integer", "description": "Always 1 for this contract version.", "minimum": 1, "maximum": 1}, "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "'sha256:' + lowercase hex sha256 over the canonical file list."}, "created_at": {"type": "string", "description": "RFC 3339 UTC timestamp of the export."}, "source": {"type": "object", "additionalProperties": true, "required": ["environment_uuid", "environment_revision", "assets"], "properties": {"environment_uuid": {"type": "string"}, "environment_revision": {"type": "string", "description": "Revision/version token of the environment the bundle was built from."}, "assets": {"type": "array", "items": {"$ref": "#/$defs/sceneBundleSourceAsset"}}}}, "root_layer": {"type": "string", "pattern": "^\\.?[A-Za-z0-9_+@=-][A-Za-z0-9_.+@=-]*(/\\.?[A-Za-z0-9_+@=-][A-Za-z0-9_.+@=-]*)*$", "description": "Root USD layer, a confined relative path that is also listed in files."}, "files": {"type": "array", "items": {"$ref": "#/$defs/sceneBundleFile"}, "description": "Every file in the bundle except the manifest."}, "exporter": {"type": "object", "additionalProperties": true, "required": ["name", "version", "usd_schema_version"], "properties": {"name": {"type": "string", "description": "e.g. cyberwave-robot-format"}, "version": {"type": "string"}, "usd_schema_version": {"type": "string", "description": "Version of the Cyberwave USD schema authored."}}}, "runtime": {"type": "object", "additionalProperties": true, "required": ["isaac_version", "extension_lock_digest"], "properties": {"isaac_version": {"type": "string", "description": "Isaac Sim version the bundle was validated for."}, "extension_lock_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "description": "Digest of the Kit extension lock, or null when unpinned."}}}, "physics": {"type": "object", "additionalProperties": true, "required": ["engine", "variant", "supported_execution_profiles"], "properties": {"engine": {"enum": ["physx", "newton"], "description": "Physics engine the scene was authored and validated for. Isaac Sim's Newton engine reads the same UsdPhysics scene, so a 'physx' bundle may also list isaac-newton-physics in supported_execution_profiles; the execution profile, not this field, selects the engine at run time (see cyberwave_contracts.simulation.physics_for_execution_profile)."}, "variant": {"type": "string", "description": "Explicit engine/USD variant the scene was authored for."}, "supported_execution_profiles": {"type": "array", "items": {"enum": ["isaac-cpu-physics", "isaac-gpu-physics", "isaac-newton-physics"]}}, "isaac": {"type": "object", "additionalProperties": false, "description": "Isaac solver settings from the environment's Physics.extensions['isaac_physics'] (validated by cyberwave_contracts.simulation.normalize_isaac_physics). Omitted when the environment sets none; the plant then keeps the engine defaults.", "properties": {"solver_position_iterations": {"type": "integer", "minimum": 1, "maximum": 255, "description": "PhysX scene min and max position iteration count."}, "solver_velocity_iterations": {"type": "integer", "minimum": 0, "maximum": 255, "description": "PhysX scene min and max velocity iteration count."}, "substeps": {"type": "integer", "minimum": 1, "maximum": 64, "description": "Physics sub-steps per plant step."}}}}}, "units": {"type": "object", "additionalProperties": true, "required": ["meters_per_unit", "kilograms_per_unit", "up_axis"], "properties": {"meters_per_unit": {"type": "number", "description": "Always 1.0 (meters).", "minimum": 1.0, "maximum": 1.0}, "kilograms_per_unit": {"type": "number", "description": "Always 1.0 (kilograms).", "minimum": 1.0, "maximum": 1.0}, "up_axis": {"const": "Z"}}}, "identity_map": {"type": "object", "additionalProperties": true, "required": ["twins", "links", "joints", "sensors", "cameras"], "properties": {"twins": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["twin_uuid", "usd_path"], "properties": {"twin_uuid": {"type": "string"}, "usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}}}}, "links": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["twin_uuid", "link", "usd_path"], "properties": {"twin_uuid": {"type": "string"}, "link": {"type": "string"}, "usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}}}}, "joints": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["twin_uuid", "joint", "usd_path", "dof_index"], "properties": {"twin_uuid": {"type": "string"}, "joint": {"type": "string", "description": "Cyberwave joint name as used in commands and state."}, "usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}, "dof_index": {"type": "integer", "minimum": 0}}}}, "sensors": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["twin_uuid", "sensor_id", "kind", "usd_path"], "properties": {"twin_uuid": {"type": ["string", "null"]}, "sensor_id": {"type": "string"}, "kind": {"enum": ["rgb", "depth", "imu", "lidar", "range", "point_cloud", "first_person_camera", "sim_viewport"]}, "usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}}}}, "cameras": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["twin_uuid", "camera_id", "role", "usd_path"], "properties": {"twin_uuid": {"type": ["string", "null"], "description": "Null for environment cameras such as sim_viewport."}, "camera_id": {"type": "string"}, "sensor_id": {"type": ["string", "null"]}, "role": {"enum": ["sensor", "first_person", "sim_viewport"]}, "usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}}}}, "materials": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["material_id", "usd_path"], "properties": {"material_id": {"type": "string"}, "usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}}}}}, "description": "Stable Cyberwave-identity to USD prim path maps. USD paths are prim paths inside the stage, not filesystem paths."}, "articulations": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["twin_uuid", "root_usd_path", "base"], "properties": {"twin_uuid": {"type": "string"}, "root_usd_path": {"type": "string", "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"}, "base": {"enum": ["fixed", "floating"]}, "drives": {"type": "array", "items": {"type": "object", "description": "Per-joint drive declaration (joint, mode, gains, limits)."}}, "reset": {"type": "object", "description": "Initial/reset state declaration (joint positions, base pose)."}}}}, "sensors": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["sensor_id", "twin_uuid", "kind", "fidelity", "params"], "properties": {"sensor_id": {"type": "string"}, "twin_uuid": {"type": ["string", "null"]}, "kind": {"enum": ["rgb", "depth", "imu", "lidar", "range", "point_cloud", "first_person_camera", "sim_viewport"]}, "fidelity": {"type": "string", "description": "Fidelity label, e.g. 'geometric_ray', 'rendered', 'heuristic'. Never implies more physical fidelity than implemented."}, "params": {"type": "object", "description": "Kind-specific descriptor (rate, resolution, range, intrinsics, noise)."}}}}, "compatibility": {"type": "object", "additionalProperties": true, "required": ["errors", "warnings", "rejected_features"], "properties": {"errors": {"type": "array", "items": {"$ref": "#/$defs/sceneBundleFinding"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/sceneBundleFinding"}}, "rejected_features": {"type": "array", "items": {"$ref": "#/$defs/sceneBundleFinding"}}}}, "resource_estimate": {"type": "object", "additionalProperties": true, "properties": {"cpu_cores": {"type": "number", "minimum": 0}, "ram_mb": {"type": "number", "minimum": 0}, "vram_mb": {"type": "number", "minimum": 0}, "disk_mb": {"type": "number", "minimum": 0}, "gpu_required": {"type": "boolean", "description": "True when rendering/cameras require an RTX GPU."}}, "description": "Aggregate estimate used by scheduling preflight."}, "provenance": {"type": "object", "additionalProperties": true, "required": ["toolchain", "attestation_ref"], "properties": {"toolchain": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Tool name -> version used to author the bundle."}, "attestation_ref": {"type": ["string", "null"], "description": "Opaque reference to a signature/attestation record; never a URL."}}}}, "$defs": {"sceneBundleFile": {"type": "object", "additionalProperties": true, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "pattern": "^\\.?[A-Za-z0-9_+@=-][A-Za-z0-9_.+@=-]*(/\\.?[A-Za-z0-9_+@=-][A-Za-z0-9_.+@=-]*)*$", "description": "Confined relative POSIX path."}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Lowercase hex sha256 of the file bytes."}, "size": {"type": "integer", "description": "Size in bytes.", "minimum": 0}}}, "sceneBundleSourceAsset": {"type": "object", "additionalProperties": true, "required": ["asset_uuid", "registry_id", "revision", "content_hash"], "properties": {"asset_uuid": {"type": "string"}, "registry_id": {"type": ["string", "null"]}, "revision": {"type": "string"}, "content_hash": {"type": ["string", "null"]}}}, "sceneBundleFinding": {"type": "object", "additionalProperties": true, "required": ["code", "message"], "properties": {"code": {"type": "string", "description": "Stable machine-readable code."}, "message": {"type": "string", "description": "Human-readable detail."}, "asset_uuid": {"type": ["string", "null"]}, "twin_uuid": {"type": ["string", "null"]}, "subject": {"type": ["string", "null"], "description": "Link, joint, sensor or file the finding is about."}}}}}