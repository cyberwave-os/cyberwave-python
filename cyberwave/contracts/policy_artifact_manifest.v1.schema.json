{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.cyberwave.com/policy_artifact_manifest.v1.schema.json", "title": "Cyberwave Policy Artifact Manifest", "description": "Canonical manifest for policy artifact files shared by seeding, uploads, simulation export, and simulator loading.", "type": "object", "additionalProperties": true, "required": ["version"], "properties": {"version": {"const": "policy_artifact_manifest.v1"}, "format": {"type": "string"}, "artifact_prefix": {"type": "string"}, "cdn_prefix": {"type": "string"}, "uploaded_files": {"type": "array", "items": {"$ref": "#/$defs/artifactFile"}}, "required_files": {"type": "array", "items": {"$ref": "#/$defs/artifactFile"}}, "optional_files": {"type": "array", "items": {"$ref": "#/$defs/artifactFile"}}, "updated_at": {"type": "string"}}, "$defs": {"artifactFile": {"type": "object", "additionalProperties": true, "required": ["path"], "properties": {"path": {"type": "string"}, "download_url": {"type": "string"}, "storage_key": {"type": "string"}, "content_type": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string"}, "required": {"type": "boolean"}}}}}