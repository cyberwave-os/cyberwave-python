{
  "version": 1,
  "title": "Marconi100 ExaMon export",
  "description": "CINECA Marconi100 telemetry (M100 ExaData). Hive-partitioned Parquet: one folder per plugin and metric, one row per reading with the server in the 'node' column.",
  "files": {"glob": "**/*.parquet", "format": "parquet"},
  "path_pattern": "**/plugin={source}_pub/metric={signal}/*.parquet",
  "layout": "long",
  "time": {"column": "timestamp", "timezone": "UTC"},
  "thing": {"columns": ["node", "device", "panel", "partition"], "format": "{column}={value}"},
  "value": {"column": "value"},
  "signal": "{source}/{signal}",
  "slots": {
    "inlet_temperature": "ipmi/ambient",
    "total_power": "ipmi/total_power",
    "cpu0_power": "ipmi/p0_power",
    "cpu1_power": "ipmi/p1_power",
    "cpu0_temperature": "ipmi/p0_vdd_temp",
    "cpu1_temperature": "ipmi/p1_vdd_temp",
    "gpu0_temperature": "ipmi/gpu0_core_temp",
    "gpu1_temperature": "ipmi/gpu1_core_temp",
    "gpu2_temperature": "ipmi/gpu3_core_temp",
    "gpu3_temperature": "ipmi/gpu4_core_temp",
    "fan_speed": "ipmi/fan0_0",
    "psu0_input_power": "ipmi/ps0_input_power",
    "psu1_input_power": "ipmi/ps1_input_power"
  },
  "signals": {
    "ipmi/*_temp": {"type": "temperature", "unit": "°C"},
    "ipmi/*_status": {"type": "status", "hidden": true},
    "ipmi/ambient": {"type": "temperature", "unit": "°C", "label": "Inlet air temperature"},
    "ipmi/fan*": {"type": "fan_speed", "unit": "rpm"},
    "ipmi/gpu*_core_temp": {"type": "temperature", "unit": "°C"},
    "ipmi/gpu*_mem_temp": {"type": "temperature", "unit": "°C"},
    "ipmi/p*_power": {"type": "power", "unit": "W"},
    "ipmi/*_power": {"type": "power", "unit": "W"},
    "ipmi/total_power": {"type": "power", "unit": "W", "label": "Server total power"},
    "ipmi/*_vdd_temp": {"type": "temperature", "unit": "°C"},
    "ganglia/Gpu*_power_usage": {"type": "power", "unit": "W"},
    "ganglia/Gpu*_temp": {"type": "temperature", "unit": "°C"},
    "ganglia/Gpu*_utilization": {"type": "utilization", "unit": "%"},
    "ganglia/cpu_*": {"type": "utilization", "unit": "%"},
    "ganglia/mem_*": {"type": "memory", "unit": "kB"},
    "ganglia/bytes_*": {"type": "network", "unit": "B/s"},
    "ganglia/pkts_*": {"type": "network", "unit": "pkt/s"},
    "ganglia/load_*": {"type": "load", "unit": ""},
    "vertiv/*Temperature*": {"type": "temperature", "unit": "°C"},
    "vertiv/*Humidity*": {"type": "humidity", "unit": "%"},
    "vertiv/*Utilization": {"type": "utilization", "unit": "%"},
    "vertiv/Fan_Speed": {"type": "fan_speed", "unit": "%"},
    "vertiv/*Pressure*": {"type": "pressure", "unit": "Pa"},
    "vertiv/*Valve_Open_Position": {"type": "position", "unit": "%"},
    "vertiv/*Status": {"type": "status"},
    "schneider/*": {"scale": 0.1},
    "logics/*": {"type": "generic"},
    "weather/temp": {"type": "temperature", "unit": "°C", "label": "Outdoor temperature"},
    "weather/feels_like": {"type": "temperature", "unit": "°C", "label": "Outdoor feels-like temperature"},
    "weather/dew_point": {"type": "temperature", "unit": "°C", "label": "Outdoor dew point"},
    "weather/humidity": {"type": "humidity", "unit": "%", "label": "Outdoor humidity"},
    "weather/pressure": {"type": "pressure", "unit": "hPa", "label": "Outdoor air pressure"},
    "weather/wind_speed": {"type": "speed", "unit": "m/s", "label": "Wind speed"},
    "weather/wind_deg": {"type": "direction", "unit": "°", "label": "Wind direction"},
    "weather/clouds": {"type": "ratio", "unit": "%", "label": "Cloud cover"},
    "weather/uvi": {"type": "index", "unit": "", "label": "UV index"},
    "weather/visibility": {"type": "distance", "unit": "m", "label": "Visibility"}
  }
}
