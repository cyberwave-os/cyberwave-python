<?xml version="1.0"?>
<!-- Reviewed self-collision matrix for collision_arm.urdf: only the adjacent
     links, which touch at their joints in every configuration. -->
<robot name="collision_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool_link"/>
  </group>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="finger_link" reason="Adjacent"/>
</robot>
