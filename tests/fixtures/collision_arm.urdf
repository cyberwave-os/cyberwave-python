<?xml version="1.0"?>
<!-- Six-revolute test arm with PRIMITIVE collision geometry (no meshes), so
     collision models build anywhere pinocchio does. Paired with
     collision_arm.srdf. Used by tests/test_collision_aware_kinematics.py. -->
<robot name="collision_arm">
  <link name="base_link">
    <collision><origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.16 0.16 0.08"/></geometry></collision>
  </link>
  <link name="link1">
    <collision><origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry></collision>
  </link>
  <link name="link2">
    <collision><origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.25"/></geometry></collision>
  </link>
  <link name="link3">
    <collision><origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.2"/></geometry></collision>
  </link>
  <link name="link4">
    <collision><origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.05"/></geometry></collision>
  </link>
  <link name="link5">
    <collision><origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.06"/></geometry></collision>
  </link>
  <link name="link6">
    <collision><origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry></collision>
  </link>
  <link name="tool_link">
    <collision><origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.03 0.06 0.04"/></geometry></collision>
  </link>
  <link name="finger_link">
    <collision><origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.04"/></geometry></collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="10" velocity="3"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="3"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="3"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="5" velocity="3"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="5" velocity="3"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="5" velocity="2"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="link6"/><child link="tool_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <joint name="finger_joint" type="prismatic">
    <parent link="tool_link"/><child link="finger_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="5" velocity="0.1"/>
  </joint>
</robot>
